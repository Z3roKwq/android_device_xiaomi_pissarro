on charger
    # Enable UFS powersaving
    write /sys/devices/platform/bootdevice/clkgate_enable 1

    # Disable perfmgr tuning during charging
    write /proc/perfmgr/boost_ctrl/cpu_ctrl/boot_freq "-1 -1 -1 -1"

    write /sys/devices/platform/boot_dramboost/dramboost/dramboost 0

    # Keep two little and one big
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/devices/system/cpu/cpu4/online 0
    write /sys/devices/system/cpu/cpu5/online 0
    write /sys/devices/system/cpu/cpu7/online 0

on post-fs
    # Boot time perfmgr tuning
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "0 100"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "1 100"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "2 100"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "3 100"

on init
    # Disable UFS powersaving
    write /sys/devices/platform/bootdevice/clkgate_enable 0

    # Set teo as cpuidle governor
    write /sys/devices/system/cpu/cpuidle/current_governor teo

    # Set schedutil as scaling governor
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "schedutil"

    # Boot time FS tuning
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/nr_requests 256
    write /sys/block/sdc/queue/iostats 0
    write /sys/block/sdc/queue/nr_requests 256

    # Boot time perfmgr tuning
    write /proc/perfmgr/boost_ctrl/cpu_ctrl/boot_freq "0 0 0 0"
    
    write /sys/devices/platform/boot_dramboost/dramboost/dramboost 1

    # Setup stune groups and permissions
    chown system system /dev/stune

    # Create energy-aware scheduler tuning nodes
    mkdir /dev/stune/nnapi-hal
    mkdir /dev/stune/camera-daemon
    mkdir /dev/stune/background
    mkdir /dev/stune/foreground
    mkdir /dev/stune/top-app
    mkdir /dev/stune/rt
    mkdir /dev/stune/io

    # NNAPI-HAL
    chown system system /dev/stune/nnapi-hal
    chown system system /dev/stune/nnapi-hal/tasks
    chmod 0664 /dev/stune/nnapi-hal/tasks
    chown system system /dev/stune/nnapi-hal/schedtune.boost
    chmod 0664 /dev/stune/nnapi-hal/schedtune.boost
    chown system system /dev/stune/nnapi-hal/schedtune.prefer_idle
    chmod 0664 /dev/stune/nnapi-hal/schedtune.prefer_idle

    # Camera-Daemon
    chown system system /dev/stune/camera-daemon
    chown system system /dev/stune/camera-daemon/tasks
    chmod 0664 /dev/stune/camera-daemon/tasks
    chown system system /dev/stune/camera-daemon/schedtune.boost
    chmod 0664 /dev/stune/camera-daemon/schedtune.boost
    chown system system /dev/stune/camera-daemon/schedtune.prefer_idle
    chmod 0664 /dev/stune/camera-daemon/schedtune.prefer_idle
    
    # Background
    chown system system /dev/stune/background
    chown system system /dev/stune/background/tasks
    chmod 0664 /dev/stune/background/tasks
    chown system system /dev/stune/background/schedtune.boost
    chmod 0664 /dev/stune/background/schedtune.boost
    chown system system /dev/stune/background/schedtune.prefer_idle
    chmod 0664 /dev/stune/background/schedtune.prefer_idle

    # Foreground
    chown system system /dev/stune/foreground
    chown system system /dev/stune/foreground/tasks
    chmod 0664 /dev/stune/foreground/tasks
    chown system system /dev/stune/foreground/schedtune.boost
    chmod 0664 /dev/stune/foreground/schedtune.boost
    chown system system /dev/stune/foreground/schedtune.prefer_idle
    chmod 0664 /dev/stune/foreground/schedtune.prefer_idle

    # Top-App
    chown system system /dev/stune/top-app
    chown system system /dev/stune/top-app/tasks
    chmod 0664 /dev/stune/top-app/tasks
    chown system system /dev/stune/top-app/schedtune.boost
    chmod 0664 /dev/stune/top-app/schedtune.boost
    chown system system /dev/stune/top-app/schedtune.prefer_idle
    chmod 0664 /dev/stune/top-app/schedtune.prefer_idle

    # RT
    chown system system /dev/stune/rt
    chown system system /dev/stune/rt/tasks
    chmod 0664 /dev/stune/rt/tasks
    chown system system /dev/stune/rt/schedtune.boost
    chmod 0664 /dev/stune/rt/schedtune.boost
    chown system system /dev/stune/rt/schedtune.prefer_idle
    chmod 0664 /dev/stune/rt/schedtune.prefer_idle

    # IO
    chown system system /dev/stune/io
    chown system system /dev/stune/io/tasks
    chmod 0664 /dev/stune/io/tasks

    # Update cpus for cpuset cgroup
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/background/cpus 0-2
    write /dev/cpuset/foreground/cpus 0-5
    write /dev/cpuset/foreground/boost/cpus 0-6
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/camera-daemon/cpus 0-5

on enable-low-power
    # Enable UFS powersaving
    write /sys/devices/platform/bootdevice/clkgate_enable 1

    # Runtime FS tuning
    # We should adjust the setting upon boot_complete for runtime performance
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    write /sys/block/sdc/queue/iostats 1
    write /sys/block/sdc/queue/nr_requests 128
    write /sys/block/sdc/queue/read_ahead_kb 512

    write /sys/block/dm-0/queue/read_ahead_kb 128
    write /sys/block/dm-1/queue/read_ahead_kb 128
    write /sys/block/dm-2/queue/read_ahead_kb 128
    write /sys/block/dm-3/queue/read_ahead_kb 128
    write /sys/block/dm-4/queue/read_ahead_kb 128
    write /sys/block/dm-5/queue/read_ahead_kb 128

    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/dirty_expire_centisecs 200

    # Give permission for cpufreq
    chown system system /proc/cpufreq/cpufreq_sched_disable
    chmod 0660 /proc/cpufreq/cpufreq_sched_disable
    chown system system /proc/cpufreq/cpufreq_cci_mode
    chmod 0660 /proc/cpufreq/cpufreq_cci_mode

    # Give permissions for perfmgr
    chown system system /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_uclamp_min
    chmod 0660 /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_uclamp_min
    chown system system /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_bg_uclamp_min
    chmod 0660 /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_bg_uclamp_min
    chown system system /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_fg_uclamp_min
    chmod 0660 /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_fg_uclamp_min
    chown system system /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_ta_uclamp_min
    chmod 0660 /proc/perfmgr/boost_ctrl/eas_ctrl/perfserv_ta_uclamp_min
    chown system system /proc/perfmgr/boost_ctrl/dram_ctrl/ddr
    chmod 0660 /proc/perfmgr/boost_ctrl/dram_ctrl/ddr

    # Give permissions for PPM
    chown system system /proc/ppm/policy_status
    chmod 0660 /proc/ppm/policy_status
    chown system system /proc/ppm/policy/cluster_0_min_freq
    chmod 0660 /proc/ppm/policy/cluster_0_min_freq
    chown system system /proc/ppm/policy/cluster_0_max_freq
    chmod 0660 /proc/ppm/policy/cluster_0_max_freq
    chown system system /proc/ppm/policy/cluster_1_min_freq
    chmod 0660 /proc/ppm/policy/cluster_1_min_freq
    chown system system /proc/ppm/policy/cluster_1_max_freq
    chmod 0660 /proc/ppm/policy/cluster_1_max_freq

    # Configure DVFS
    write /sys/kernel/ged/hal/dvfs_margin_value 130
    write /sys/kernel/ged/hal/timer_base_dvfs_margin 798
    write /sys/kernel/ged/hal/loading_base_dvfs_step 4

    # Configure scheduler
    write /proc/sys/kernel/sched_migration_cost_ns 200000
    write /proc/sys/kernel/sched_uclamp_util_min 128

    # Enable EAS
    write /sys/devices/system/cpu/eas/enable 2

    # Enable scheduler and cpufreq integration
    write /proc/cpufreq/cpufreq_sched_disable 0

    # Enable big task rotation
    write /proc/perfmgr/boost_ctrl/eas_ctrl/sched_big_task_rotation 1

    # Restore perfmgr parameters
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "0 0"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "1 0"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "2 0"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "3 0"
    
    write /proc/perfmgr/boost_ctrl/cpu_ctrl/boot_freq "-1 -1 -1 -1 -1 -1"

    write /sys/devices/platform/boot_dramboost/dramboost/dramboost 0
    
    # Configure schedtune
    # Common
    write /dev/stune/schedtune.boost 0
    write /dev/stune/schedtune.prefer_idle 0

    # NNAPI-HAL
    write /dev/stune/nnapi-hal/schedtune.boost 0
    write /dev/stune/nnapi-hal/schedtune.prefer_idle 0
    
    # Camera-Daemon
    write /dev/stune/camera-daemon/schedtune.boost 0
    write /dev/stune/camera-daemon/schedtune.prefer_idle 0
    
    # Background
    write /dev/stune/background/schedtune.boost 0
    write /dev/stune/background/schedtune.prefer_idle 0

    # Foreground
    write /dev/stune/foreground/schedtune.boost 0
    write /dev/stune/foreground/schedtune.prefer_idle 0

    # Top-App
    write /dev/stune/top-app/schedtune.boost 5
    write /dev/stune/top-app/schedtune.prefer_idle 0

    # RT
    write /dev/stune/rt/schedtune.boost 10
    write /dev/stune/rt/schedtune.prefer_idle 0

    # Configure PPM

    # Turn it off because we have mi_thermald active.
    write /proc/ppm/policy_status "0 0"
    write /proc/ppm/policy_status "1 0"
    
    # Turn it off because why unnecessarily limit performance??
    write /proc/ppm/policy_status "4 0"
    write /proc/ppm/policy_status "6 0"
    write /proc/ppm/policy_status "7 0"

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

on property:sys.boot_completed=1
    trigger enable-low-power